# 项目仓库 .gitignore —— 白名单模式，由 ./logo setup 从系统模板 templates/projects.gitignore 生成，请勿手改。
# 与 tools/logo.py 的 PROJECT_FILE_PATTERNS 对应；钩子会再按精确规则与密钥扫描把关。

# ── 根目录：只放行看板、本文件与各项目目录（隐藏目录除外）──
/*
!/.gitignore
!/PROJECTS.md
!/repository.toml
!/*/
/.*/

# ── 项目目录：只放行规定的文件与子目录（.final-build、.final-old 等临时目录随之忽略）──
/*/*
!/*/project.toml
!/*/brief.md
!/*/concepts/
!/*/directions/
!/*/decisions/
!/*/releases/
!/*/covers/
!/*/latest/
# dist/（./logo export / render 的按需产物）与其他目录不在白名单内，一律忽略

/*/concepts/*
!/*/concepts/.gitkeep
!/*/concepts/[0-9][0-9][0-9]-*.md
!/*/concepts/[0-9][0-9][0-9]-*.png
!/*/concepts/[0-9][0-9][0-9]-*.jpg
!/*/concepts/[0-9][0-9][0-9]-*.jpeg
!/*/concepts/[0-9][0-9][0-9]-*.webp

/*/directions/*
!/*/directions/.gitkeep
!/*/directions/[A-Z]-*/
/*/directions/*/*
!/*/directions/*/direction.md
!/*/directions/*/v[0-9][0-9][0-9]/
/*/directions/*/v*/*
!/*/directions/*/v*/logo.svg
!/*/directions/*/v*/notes.md

/*/decisions/*
!/*/decisions/.gitkeep
!/*/decisions/[0-9][0-9][0-9]-*.md

/*/releases/*
!/*/releases/.gitkeep
!/*/releases/r*/
/*/releases/r*/*
!/*/releases/r*/release.md
!/*/releases/r*/guide.md
!/*/releases/r*/layouts/
/*/releases/r*/layouts/*
!/*/releases/r*/layouts/*.svg

/*/covers/*
!/*/covers/.gitkeep
!/*/covers/[0-9][0-9][0-9]-*/
/*/covers/*/*
!/*/covers/*/cover.toml
!/*/covers/*/cover.md
!/*/covers/*/*.svg
!/*/covers/*/assets/
/*/covers/*/assets/*
!/*/covers/*/assets/[0-9][0-9][0-9]-*.md
!/*/covers/*/assets/[0-9][0-9][0-9]-*.png
!/*/covers/*/assets/[0-9][0-9][0-9]-*.jpg
!/*/covers/*/assets/[0-9][0-9][0-9]-*.jpeg
!/*/covers/*/assets/[0-9][0-9][0-9]-*.webp

/*/latest/*
!/*/latest/*-latest.svg

# ── 系列记录：_series/<系列名>/ 只放行元数据与系列规则（./logo series 管理）──
/_series/*
!/_series/[a-z0-9]*/
/_series/*/*
!/_series/*/series.toml
!/_series/*/series.md
# 家族封面：_series/<系列名>/covers/NNN-名称/（./logo cover … series:<系列名>）；dist/ 不在白名单，一律忽略
!/_series/*/covers/
/_series/*/covers/*
!/_series/*/covers/[0-9][0-9][0-9]-*/
/_series/*/covers/*/*
!/_series/*/covers/*/cover.toml
!/_series/*/covers/*/cover.md
!/_series/*/covers/*/*.svg
!/_series/*/covers/*/assets/
/_series/*/covers/*/assets/*
!/_series/*/covers/*/assets/[0-9][0-9][0-9]-*.md
!/_series/*/covers/*/assets/[0-9][0-9][0-9]-*.png
!/_series/*/covers/*/assets/[0-9][0-9][0-9]-*.jpg
!/_series/*/covers/*/assets/[0-9][0-9][0-9]-*.jpeg
!/_series/*/covers/*/assets/[0-9][0-9][0-9]-*.webp

# ── 任何位置都排除（放在最后，优先于上面的放行）──
.DS_Store
Thumbs.db
*~
*.swp
*.swo
*.tmp
*.temp
*.bak
*.orig
*.log
*.part
*.tmp.*
*.temp.*
*.bak.*
*.orig.*
*.log.*
*.part.*
.cache/
.venv/
node_modules/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.ssh/
.aws/
.gnupg/
.idea/
.vscode/
.[eE][nN][vV]
.[eE][nN][vV].*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.gpg
*.crt
*.cer
*.der
*.csr
*.p7b
*.p7c
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.git-credentials
auth.json
service-account*.json
service_account*.json
.netrc
.npmrc
.pypirc

# 收件箱是外部待确认文件，不进入设计仓库
/inbox/
