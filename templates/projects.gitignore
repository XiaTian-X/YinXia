# 项目仓库 .gitignore —— 白名单模式，由 ./logo setup 从系统模板 templates/projects.gitignore 生成，请勿手改。
# 与 tools/logo.py 的 PROJECT_FILE_PATTERNS 对应；钩子会再按精确规则与密钥扫描把关。

# ── 根目录：只放行看板、本文件与各项目目录（隐藏目录除外）──
/*
!/.gitignore
!/PROJECTS.md
!/*/
/.*/

# ── 项目目录：只放行规定的文件与子目录（.final-build、.final-old 等临时目录随之忽略）──
/*/*
!/*/project.toml
!/*/brief.md
!/*/concepts/
!/*/directions/
!/*/decisions/
!/*/releases/
# dist/（./logo export / render 的按需产物）与其他目录不在白名单内，一律忽略

/*/concepts/*
!/*/concepts/.gitkeep
!/*/concepts/[0-9][0-9][0-9]-*.md
!/*/concepts/[0-9][0-9][0-9]-*.png
!/*/concepts/[0-9][0-9][0-9]-*.jpg
!/*/concepts/[0-9][0-9][0-9]-*.jpeg
!/*/concepts/[0-9][0-9][0-9]-*.webp

/*/directions/*
!/*/directions/.gitkeep
!/*/directions/[A-Z]-*/
/*/directions/*/*
!/*/directions/*/direction.md
!/*/directions/*/v[0-9][0-9][0-9]/
/*/directions/*/v*/*
!/*/directions/*/v*/logo.svg
!/*/directions/*/v*/notes.md

/*/decisions/*
!/*/decisions/.gitkeep
!/*/decisions/[0-9][0-9][0-9]-*.md

/*/releases/*
!/*/releases/.gitkeep
!/*/releases/r*/
/*/releases/r*/*
!/*/releases/r*/release.md
!/*/releases/r*/guide.md
!/*/releases/r*/layouts/
/*/releases/r*/layouts/*
!/*/releases/r*/layouts/*.svg

# ── 任何位置都排除（放在最后，优先于上面的放行）──
.DS_Store
Thumbs.db
*~
*.swp
*.swo
*.tmp
*.temp
*.bak
*.orig
*.log
*.part
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.gpg
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.netrc
.npmrc
.pypirc
