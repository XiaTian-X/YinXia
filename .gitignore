# 系统仓库 .gitignore —— 白名单模式。
# 与 tools/logo.py 的 SYSTEM_FILE_PATTERNS 保持一致；钩子会再按精确规则与密钥扫描把关。

# ── 第一层：根目录默认忽略一切，只放行系统必需的文件与目录 ──
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/logo
!/.agents/
!/.claude/
!/.githooks/
!/assets/
!/config/
!/templates/
!/tools/
!/tests/
# 因此被忽略的包括：/projects/（独立的项目仓库）、/.cache/（预览与下载缓存）、/.venv/、
# /inbox/（外部设计的收件箱：原件来历与授权未确认前不进任何仓库），以及根目录的任何其他文件

# ── 第二层：放行的目录内，只放行规定的文件类型（与 SYSTEM_FILE_PATTERNS 对应）──
/tools/*
!/tools/*.py
!/tools/requirements.txt
/tests/*
!/tests/*.py
/templates/*
!/templates/*.md
!/templates/*.svg
!/templates/*.toml
!/templates/*.gitignore
/config/*
!/config/*.toml
/.githooks/*
!/.githooks/pre-commit
!/.githooks/projects/
/.githooks/projects/*
!/.githooks/projects/pre-commit
/assets/*
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/fonts.toml
!/assets/fonts/*/
/assets/fonts/*/*
!/assets/fonts/*/LICENSE*
!/assets/fonts/*/OFL*
/.claude/*
!/.claude/settings.json
!/.claude/commands/
!/.claude/agents/
!/.claude/skills/

# ── 第三层：任何位置都排除（放在最后，优先于上面的放行）──

# 系统与编辑器杂物
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.idea/
.vscode/

# Python 缓存
__pycache__/
*.py[cod]

# 临时文件、日志、未完成的下载
*.tmp
*.temp
*.bak
*.orig
*.log
*.part

# 密钥与凭据
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.gpg
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*credential*
*secret*
.netrc
.npmrc
.pypirc

# Claude Code 个人设置（共享的 .claude/settings.json 可以提交）
.claude/settings.local.json

# 字体文件不进 Git（上面的白名单已排除，此处再明确一次）：由 ./logo fonts fetch 按 fonts.toml 下载并校验
assets/fonts/**/*.otf
assets/fonts/**/*.ttf
assets/fonts/**/*.ttc
assets/fonts/**/*.woff
assets/fonts/**/*.woff2
